<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <customErrors mode="Off"/>
    <httpRuntime targetFramework="4.8" />
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="default.aspx" />
      </files>
    </defaultDocument>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".7z" allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <staticContent>
      <remove fileExtension=".7z" />
      <mimeMap fileExtension=".7z" mimeType="application/x-7z-compressed" />
    </staticContent>

    <handlers>
      <add name="ASPX-Integrated" path="*.aspx" verb="GET,HEAD,POST,DELETE" type="System.Web.UI.PageHandlerFactory"
           preCondition="integratedMode" />
    </handlers>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <rewrite>
      <rules>
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:0}" redirectType="Permanent" />
        </rule>
        <rule name="Updates root (trailing slash)" stopProcessing="true">
          <match url="^updates/$" />
          <action type="Redirect" url="https://{HTTP_HOST}/updates" redirectType="Permanent" />
        </rule>
        <rule name="Updates root" stopProcessing="true">
          <match url="^updates$" />
          <action type="Rewrite" url="updates.aspx" />
        </rule>
        <rule name="Python-urllib root to updates" stopProcessing="true">
          <match url="^/?$" />
          <conditions>
            <add input="{HTTP_USER_AGENT}" pattern="Python-urllib" ignoreCase="true" />
          </conditions>
          <action type="Rewrite" url="updates.aspx" />
        </rule>
        <rule name="Remove trailing slash from config paths" stopProcessing="true">
          <match url="^(config|c)(/.*)?/$" />
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}{R:2}" redirectType="Permanent" />
        </rule>
        <rule name="Short Config with ID" stopProcessing="true">
          <match url="^c/([a-z0-9]+)$" />
          <action type="Redirect" url="https://storyweaver.zeugs.me/config/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Short Config Root" stopProcessing="true">
          <match url="^c$" />
          <action type="Redirect" url="https://storyweaver.zeugs.me/config" appendQueryString="false" />
        </rule>
        <rule name="Canonical domain" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^sw\.zeugs\.me$" />
          </conditions>
          <action type="Redirect" url="https://storyweaver.zeugs.me/{R:0}" redirectType="Permanent" />
        </rule>
        <rule name="Config with ID" stopProcessing="true">
          <match url="^config/([a-z0-9]+)$" />
          <action type="Rewrite" url="config.aspx?id={R:1}" />
        </rule>
        <rule name="Config Root" stopProcessing="true">
          <match url="^config$" />
          <action type="Rewrite" url="config.aspx" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
